<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
    <children>
        <Pane prefHeight="404.0" prefWidth="600.0" style="-fx-background-color: #00a8ff;">
            <children>
                <Button fx:id="btnCadastrarAction" layoutX="519.0" layoutY="196.0" mnemonicParsing="false" onAction="#btnCadastrarAction" prefHeight="31.0" prefWidth="74.0" style="-fx-background-color: #90EE90;" text="Cadastrar" />
                <Button fx:id="btnEditar" layoutX="519.0" layoutY="263.0" mnemonicParsing="false" prefHeight="31.0" prefWidth="64.0" style="-fx-background-color: #FFFFE0;" text="Editar" />
                <Button fx:id="btnExcluir" layoutX="519.0" layoutY="329.0" mnemonicParsing="false" prefHeight="31.0" prefWidth="64.0" style="-fx-background-color: #FF7F7F;" text="Excluir" />

                <Label fx:id="lblNome" layoutX="30.0" layoutY="75.0" text="Nome:" />
                <Label fx:id="lblIdade" layoutX="30.0" layoutY="112.0" text="Email" />
                <Label fx:id="lblPosicao" layoutX="242.0" layoutY="75.0" text="Disciplina" />
                <Label fx:id="lblTime" layoutX="251.0" layoutY="45.0" text="Salário" />

                <TextField fx:id="txtNome" layoutX="74.0" layoutY="71.0" promptText="Digite o nome" style="-fx-background-color: #fff6ed;" />
                <TextField fx:id="txtEmail" layoutX="74.0" layoutY="108.0" promptText="Digite o email" style="-fx-background-color: #fff6ed;" />
                <TextField fx:id="txtDisciplina" layoutX="300.0" layoutY="71.0" promptText="Digite a disciplina" style="-fx-background-color: #fff6ed;" />

                <TextField fx:id="numSalario" layoutX="300.0" layoutY="41.0" promptText="0.00" style="-fx-background-color: #fff6ed;" />

                <TableView fx:id="tblVolei" layoutX="30.0" layoutY="169.0" prefHeight="200.0" prefWidth="474.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                        <TableColumn fx:id="colNome" prefWidth="75.0" text="Nome" />
                        <TableColumn fx:id="colIdade" prefWidth="75.0" text="Email" />
                        <TableColumn fx:id="colPosicao" prefWidth="75.0" text="Salario" />
                        <TableColumn fx:id="colTime" prefWidth="75.0" text="Disciplina" />
                    </columns>
                </TableView>

                <Label fx:id="lblId" layoutX="42.0" layoutY="45.0" text="ID:" />
                <TextField fx:id="intId" layoutX="74.0" layoutY="41.0" promptText="Ex: 1" style="-fx-background-color: #fff6ed;" />
            </children>
        </Pane>
    </children>
</AnchorPane>
